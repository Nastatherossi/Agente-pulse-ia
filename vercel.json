{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/conversation.js": {
      "maxDuration": 45
    },
    "api/whatsapp.js": {
      "maxDuration": 60
    },
    "api/auth-sms-hook.js": {
      "maxDuration": 20
    },
    "api/admin.js": {
      "maxDuration": 20
    },
    "api/reminders.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 12 * * *"
    }
  ]
}
